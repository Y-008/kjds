  "purpose": "Freeze source and pattern adoption decisions for the Commander and media subagent program without installing or executing a new runtime.",
  "decision_vocabulary": {
    "preferred_protocol": "Use as the first protocol candidate after pinning, fixture replay, tenant isolation and credential-boundary tests pass.",
    "existing_runtime": "Reuse the already governed isolated runtime under its current admitted-template and evidence controls.",
    "adopt_pattern": "Reimplement a bounded interface, event or workflow pattern without importing the upstream runtime.",
    "pilot_isolated": "Evaluate only in a disposable environment after license, checksum, model-rights and representative-fixture review.",
    "watch": "Track the source until a measured capability gap and complete admission evidence exist.",
    "reject_runtime": "Keep the runtime outside KJDS because it duplicates authority or widens the credential, browser or write surface."
  },
