{
  "registry_id": "KJDS-LOOP-001",
  "version": "2.0",
  "status": "active",
  "updated_at": "2026-08-03",
  "principle": "automation must produce evidence, skills must be versioned, integrations must be least-privilege, subagents must be bounded, worktrees must be isolated, and memory must preserve provenance",
  "modules": [
    {
      "id": "automations",
      "purpose": "按时间、事件或人工批准触发有界任务",
      "current_surfaces": ["scripts/verify-g1.ps1", "scripts/run-ozon-read-worker.ps1", "scripts/authority_radar", "OpenClaw command jobs"],
      "state": "partial",
      "required_controls": ["idempotency_key", "timeout", "retry_limit", "kill_switch", "run_id", "evidence_id"],
      "promotion_gate": "G0 for read-only; G6 for production writes"
    },
    {
      "id": "skills",
      "purpose": "把已验证的业务能力封装为可复用、可评测、可回滚的程序记忆",
      "current_surfaces": ["apps/control_plane application services", "causal policy registry", "docs/project/MASTER_SPEC.md"],
      "state": "design_only",
      "required_controls": ["skill_id", "version", "input_contract", "tool_allowlist", "success_metric", "failure_condition", "rollback", "evaluation_set", "owner"],
      "promotion_gate": "Proposal -> Evaluation -> Shadow -> Audit -> Promotion"
    },
    {
      "id": "integrations",
      "purpose": "把外部平台、文件、模型和通知系统接入稳定协议",
      "current_surfaces": ["apps/control_plane/ozon_worker.py", "apps/control_plane/ozon_read_worker.py", "apps/control_plane/connectors.py", "docs/project/registries/china_platform_connectors.json"],
      "state": "partial",
      "required_controls": ["credential_isolation", "allowed_operations", "schema_version", "timeout", "rate_limit", "response_evidence", "readback"],
      "promotion_gate": "G0 read-only contract; G6 write connector"
    },
    {
      "id": "subagents",
      "purpose": "用受限专业角色分解任务，避免单一超级 Agent 持有全部权限",
      "current_surfaces": ["Evidence/Compliance", "Product/Sourcing", "Finance/Cash", "Experiment", "Risk/Red-team", "Execution"],
      "state": "design_only",
      "required_controls": ["agent_identity", "role_scope", "budget", "tool_allowlist", "handoff_contract", "independent_review", "trace"],
      "promotion_gate": "G5 shadow; G6 controlled execution"
    },
    {
      "id": "worktrees",
      "purpose": "隔离并行变更、实验分支、审查和回滚边界",
      "current_surfaces": ["AGENTS.md", "docs/project/03_REMAINING_WORK_AND_PARALLEL_PLAN.md", "G-1 disposable database and web smoke"],
      "state": "process_only",
      "required_controls": ["single_owner_per_shared_schema", "clean_diff_review", "migration_replay", "artifact_retention", "no_destructive_git"],
      "promotion_gate": "required for parallel code changes; no production promotion without review"
    },
    {
      "id": "memory",
      "purpose": "保存事实、知识、程序记忆及其来源、版本、置信度和失效条件",
      "current_surfaces": ["Evidence Ledger", "Fact Promotion", "Decision Lifecycle", "Causal Knowledge", "Authority Radar SQLite"],
      "state": "partial",
      "required_controls": ["source", "captured_at", "effective_at", "hash", "confidence", "requires_review", "lineage", "retention"],
      "promotion_gate": "Evidence Gate and independent review"
    }
  ],
  "loop_contract": [
    "Observe or propose",
    "Validate inputs and permissions",
    "Execute in bounded or shadow mode",
    "Capture result and evidence",
    "Review independently",
    "Promote only after Gate",
    "Record failure and expiry conditions",
    "Re-evaluate before reuse"
  ],
  "team_agent_contract": {
    "architecture": "coordinator_plus_bounded_specialists_plus_independent_verifier",
    "roles": [
      "coordinator",
      "research",
      "evidence",
      "product",
      "finance",
      "risk",
      "execution",
      "independent_verifier"
    ],
    "required_per_role": [
      "agent_identity",
      "exact_scope",
      "tool_allowlist",
      "data_allowlist",
      "cost_budget",
      "time_budget",
      "handoff_contract",
      "trace_id",
      "eval_policy_version"
    ],
    "separation_of_duties": {
      "proposal_author_may_verify": false,
      "proposal_author_may_approve": false,
      "coordinator_may_issue_permit": false,
      "agent_may_expand_own_scope": false,
      "agent_may_reveal_credentials": false,
      "agent_may_perform_external_write": false
    }
  },
  "evolution_loop": {
    "contract_id": "kjds-governed-team-agent-evolution-v1",
    "states": [
      "observation",
      "skill_candidate",
      "evaluation",
      "shadow",
      "independent_review",
      "promoted",
      "active",
      "rolled_back",
      "retired"
    ],
    "learning_inputs": [
      "human_correction",
      "verified_failure",
      "evidence_backed_outcome",
      "policy_violation",
      "cost_or_latency_regression",
      "official_source_change"
    ],
    "promotion_requirements": [
      "versioned_candidate",
      "frozen_eval_set",
      "baseline_comparison",
      "negative_and_scope_tests",
      "shadow_result",
      "independent_review",
      "rollback_artifact",
      "owner_and_expiry"
    ],
    "allowed_transitions": [
      "observation->skill_candidate",
      "skill_candidate->evaluation",
      "evaluation->shadow",
      "evaluation->rolled_back",
      "shadow->independent_review",
      "shadow->rolled_back",
      "independent_review->promoted",
      "independent_review->rolled_back",
      "promoted->active",
      "promoted->rolled_back",
      "active->rolled_back",
      "active->retired",
      "rolled_back->skill_candidate",
      "rolled_back->retired"
    ],
    "transition_controls": {
      "append_only_audit_required": true,
      "atomic_transition_required": true,
      "idempotency_key_required": true,
      "expected_previous_state_required": true,
      "evidence_reference_required": true,
      "candidate_author_may_review": false,
      "candidate_author_may_promote": false,
      "reviewer_must_differ_from_candidate_author": true,
      "active_requires_human_owner_and_risk_authority": true
    },
    "automatic_promotion_allowed": false,
    "runtime_code_self_modification_allowed": false,
    "runtime_permission_self_modification_allowed": false,
    "formal_fact_self_promotion_allowed": false,
    "external_write_self_enable_allowed": false
  },
  "graph_learning_contract": {
    "canonical_graph_remains_authority": true,
    "versioned_node_types": [
      "AgentRole",
      "SkillVersion",
      "EvalSetVersion",
      "ModelProfileVersion",
      "ToolContractVersion",
      "PolicyVersion",
      "Evidence",
      "Outcome",
      "FailurePattern"
    ],
    "allowed_learning_edges": [
      "derived_from",
      "evaluated_by",
      "shadowed_against",
      "reviewed_by",
      "supersedes",
      "rolled_back_to",
      "supported_by",
      "invalidated_by"
    ],
    "generated_node_or_edge_status": "observation_until_independent_promotion",
    "raw_cross_tenant_learning_allowed": false,
    "deidentified_pattern_requires_license_and_revocation": true,
    "temporal_validity_and_source_hash_required": true
  },
  "continuous_update_contract": {
    "source_priority": [
      "official_specification",
      "official_release_note",
      "primary_research",
      "maintainer_repository",
      "measured_kjds_outcome"
    ],
    "default_review_cadence": "weekly",
    "material_change_triggers": [
      "security_advisory",
      "breaking_spec_change",
      "stable_release",
      "deprecation",
      "measured_quality_or_cost_regression",
      "new_kjds_business_need"
    ],
    "source_change_creates": "observation_or_skill_candidate",
    "source_change_auto_installs_dependency": false,
    "source_change_auto_changes_adoption_decision": false,
    "source_change_auto_changes_business_gate": false
  }
}
