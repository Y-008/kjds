    "type_specific_metadata": {
      "image": ["width", "height"],
      "video": ["width", "height", "duration_ms", "encoder_manifest_sha256"],
      "editing_blueprint": ["schema_version", "source_asset_refs"],
      "tutorial": ["tutorial_graph_version", "capture_manifest_sha256"]
