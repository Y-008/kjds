    "standalone_proposal_listing_eligible": false,
    "content_asset_attachment_requires_existing_scope_and_media_qa": true,
    "job_owns_blob_bytes": false,
    "job_owns_qa_or_approval": false
  },
  "future_public_surface": {
    "owner_task": "BAS-183",
    "canonical_mode": "asynchronous",
    "compatibility_facade": "openai_style_images_after_native_job_admission",
