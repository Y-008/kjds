{
  "schema_version": "kjds-primary-source-intake-v1",
  "as_of": "2026-08-03",
  "purpose": "Freeze the admissible first-party and primary-source data packs used by strategic benchmarking, operating truth, commercial discovery and capital allocation.",
  "policy": {
    "canonical_record_system": "existing_kjds_evidence_lineage_fact_finance_domains",
    "git_may_store_raw_business_records": false,
    "git_may_store_credentials_or_cookies": false,
    "git_may_store_bank_or_customer_rows": false,
    "model_output_is_primary_source": false,
    "marketing_claim_is_benchmark_fact": false,
    "external_write_allowed": false,
    "outreach_allowed_by_intake": false,
    "fact_promotion_requires_independent_review": true,
    "lower_grade_may_override_higher_grade": false
  },
  "primary_source_envelope": {
    "required_fields": [
      "source_contract_id",
      "source_contract_version",
      "subject_ref",
      "source_uri_or_file_ref",
      "blob_sha256",
      "byte_count",
      "mime_type",
      "captured_at",
      "effective_at",
      "recorded_at",
      "as_of",
      "scope",
      "license_and_terms",
      "allowed_purpose",
      "retention_and_deletion",
      "data_classification",
      "parser_version",
      "record_count",
      "field_count",
      "conservation_report",
      "uploader_actor_ref",
      "reviewer_actor_ref",
      "evidence_refs",
      "lineage_refs",
      "review_due_on"
    ],
    "integrity": {
      "sha256_lower_hex_length": 64,
      "raw_blob_reverification_required": true,
      "pagination_checkpoint_required_when_paged": true,
      "failed_page_register_required": true,
      "schema_drift_fails_closed": true
    },
    "privacy": {
      "secrets_in_payload_allowed": false,
      "raw_personal_contact_in_contract_fixture_allowed": false,
      "public_professional_contact_requires_purpose_and_jurisdiction": true,
      "do_not_contact_and_withdrawal_state_required": true,
      "cross_border_transfer_classification_required": true
    }
  },
  "source_grades": {
    "A": "Direct first-party operating artifact or official source, byte-verifiable and independently accepted for the stated scope.",
    "B": "Licensed or directly captured source with clear provenance but pending independent acceptance or incomplete scope.",
    "C": "Public observation, vendor claim or secondary research usable only as a hypothesis or benchmark candidate.",
    "D": "Unverified, synthetic, model-generated or ambiguous material; structure/testing only."
  },
  "source_packs": [
    {
      "id": "operating_cash_truth",
      "priority": "P0",
      "owner": "business_owner+finance_owner",
      "minimum_grade_for_fact": "A",
      "artifacts": [
        "official_platform_order_export_or_api_response",
        "official_platform_settlement_and_transaction_report",
        "bank_receipt_or_statement_reference",
        "signed_profit_cash_and_loss_thresholds"
      ],
      "eligible_outputs": ["order_fact", "settlement_fact", "cash_fact", "actual_profit_readiness"],
      "prohibited_in_git": ["raw_order_rows", "bank_details", "customer_pii", "credentials"]
    },
    {
      "id": "marketplace_demand_and_catalog",
      "priority": "P0",
      "owner": "market_intelligence_owner",
      "minimum_grade_for_fact": "A",
      "artifacts": [
        "official_category_analytics",
        "official_search_term_or_demand_report",
        "official_catalog_listing_inventory_traffic_return_export",
        "authorized_marketplace_api_response"
      ],
      "eligible_outputs": ["market_observation", "catalog_fact", "demand_signal", "return_signal"],
      "prohibited_in_git": ["account_identifier", "customer_row", "session_cookie", "api_secret"]
    },
    {
      "id": "unit_economics_supply_and_logistics",
      "priority": "P0",
      "owner": "supply_chain_owner+finance_owner",
      "minimum_grade_for_fact": "A",
      "artifacts": [
        "accepted_supplier_quote",
        "sample_and_quality_report",
        "freight_warehouse_and_last_mile_invoice",
        "tax_customs_and_fx_artifact"
      ],
      "eligible_outputs": ["supplier_offer", "cost_authority", "landed_cost", "downside_cm3"],
      "prohibited_in_git": ["supplier_contact_raw", "invoice_raw", "payment_account", "private_chat"]
    },
    {
