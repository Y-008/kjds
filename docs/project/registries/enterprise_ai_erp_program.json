        "level": "M3",
        "definition": "真实运行、确定性回放、恢复、观测和外部 Graph 验证完成。",
        "required_evidence_kinds": ["real_run", "deterministic_replay", "restore_readback", "observability", "external_graph_verification", "independent_acceptance"]
      },
      {
        "level": "M4",
        "definition": "真实客户或经营结果、单位经济和当前独立验收完成。",
        "required_evidence_kinds": ["real_customer_or_operating_outcome", "unit_economics", "customer_or_owner_acceptance", "current_independent_evidence"]
      }
    ],
    "promotion_policy": {
      "sequential_only": true,
      "independent_verifier_required": true,
      "registry_declaration_can_promote": false,
      "task_or_calendar_can_promote": false,
      "synthetic_fixture_can_prove_m3_or_m4": false,
      "stale_conflicted_or_missing_evidence_fails_closed": true
    }
  },
