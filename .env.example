# Copy this file to .env. Never commit the real .env file.
# Supabase: Dashboard -> Connect -> Session pooler (port 5432), then change
# postgres:// to postgresql+psycopg:// and keep sslmode=require.
KJDS_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
KJDS_DATABASE_PROVIDER=supabase
KJDS_REPOSITORY=postgres
KJDS_SHADOW_MODE=true
KJDS_API_KEY=replace-with-a-long-random-development-key
# One-line JSON map of dedicated identities; never print or commit real keys.
# Example: {"pilot-key":{"actor":"ozon-read-worker","roles":["pilot_reader"]},"executor-key":{"actor":"ozon-worker","roles":["executor"]}}
KJDS_API_KEYS_JSON={}
KJDS_API_ACTOR=local-operator
KJDS_API_ROLES=operator
# Local stdio MCP identity. It must map to a scoped profile in
# KJDS_API_KEYS_JSON; it never grants a separate business authority.
KJDS_MCP_API_KEY=
# Dedicated health/integrity identity; map this key to exactly the monitor role.
# Do not reuse the operator, executor, pilot-reader, or Ozon credential.
KJDS_MONITOR_API_KEY=
# Scheduled ControlPlaneOnly health checks must fail closed.
KJDS_HEALTH_REQUIRED=true
KJDS_EVIDENCE_SCAN_PAGE_SIZE=500
KJDS_EVIDENCE_SCAN_MAX_PAGES=20
# Local development may use legacy. Production must use supabase.
KJDS_WEB_AUTH_MODE=legacy
# Canonical browser-visible origin behind TLS/reverse proxy, e.g.
# https://seller.example.com. Leave blank for direct local Host validation.
KJDS_WEB_PUBLIC_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Non-secret mapping: {"SUPABASE_USER_UUID":"kjds-actor-id"}.
# The actor must have exactly one credential in KJDS_API_KEYS_JSON.
KJDS_WEB_USER_ACTORS_JSON={}
KJDS_PILOT_RUN_LEASE_SECONDS=900
KJDS_EVIDENCE_MAX_BYTES=10485760
KJDS_LIMITED_EXECUTION_ENABLED=false
KJDS_CONTROL_PLANE_URL=http://127.0.0.1:8000
# Dedicated key must appear in KJDS_API_KEYS_JSON with only the executor role.
KJDS_EXECUTOR_API_KEY=
# Non-secret actor ID mapped to KJDS_EXECUTOR_API_KEY and independently accepted under OZN-001.
KJDS_OZON_EXECUTION_IDENTITY_REF=ozon-worker
KJDS_EXECUTION_COMMAND_ID=
KJDS_EXECUTION_OFFER_ID=
# Comma-separated immutable Evidence IDs for the selected command.
KJDS_EXECUTION_EVIDENCE_IDS=
KJDS_PILOT_READER_API_KEY=
KJDS_READ_ONLY_PILOT_ID=
KJDS_READ_ONLY_IDEMPOTENCY_KEY=
KJDS_READ_ONLY_OFFER_ID=
KJDS_READ_ONLY_OFFER_IDS=
KJDS_READ_ONLY_CURSOR=
KJDS_READ_ONLY_PAGE_SIZE=10

# BAS-160 managed channel credential lease (worker + control plane must share
# the same issuer/key-id/signing key). Without a 256-bit signing key the
# control plane keeps the worker grant issuer unbound (fail closed).
KJDS_CHANNEL_LEASE_SIGNING_KEY=
KJDS_CHANNEL_LEASE_ISSUER=kjds-managed-store
KJDS_CHANNEL_LEASE_KEY_ID=lease-kid-1
KJDS_CHANNEL_WORKLOAD_IDENTITY_REF=
# Worker composition mode: unbound (default, fail closed) or managed.
KJDS_CHANNEL_CREDENTIAL_MODE=unbound
# Bounded official readback probe options (tenant/entity/store binding).
KJDS_READBACK_TENANT_REF=
KJDS_READBACK_ENTITY_REF=
KJDS_READBACK_STORE_REF=
KJDS_READBACK_SECRET_REFERENCE=

# ComfyUI is the controlled media executor. The other providers are optional
# and remain absent unless their URL is explicitly configured.
KJDS_OLLAMA_URL=
KJDS_COMFYUI_URL=http://127.0.0.1:8189
KJDS_N8N_URL=
# Governed AI Listing is off until the registry, gold set, and one real
# internal dry-run pass. Non-loopback gateways must use HTTPS.
KJDS_AI_LISTING_ENABLED=false
# Dedicated operator/admin identity from KJDS_API_KEYS_JSON; never reuse an
# Ozon writer or reviewer credential.
KJDS_AI_LISTING_WORKER_API_KEY=
KJDS_OPENAI_COMPAT_BASE_URL=
KJDS_OPENAI_COMPAT_API_KEY=
KJDS_OPENAI_COMPAT_TEXT_MODEL=
KJDS_OPENAI_COMPAT_VISION_MODEL=

# Add only after the corresponding connector is enabled. Do not send these to AI prompts.
# Read-only Ozon identity. The live writer never receives these values.
OZON_CLIENT_ID=
OZON_API_KEY=
# Dedicated listing-write identity, injected only into the one-shot live worker.
OZON_WRITE_CLIENT_ID=
OZON_WRITE_API_KEY=
OZON_API_URL=https://api-seller.ozon.ru
OZON_PRODUCT_ATTRIBUTES_PATH=/v4/product/info/attributes
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=
# Optional ERPNext sidecar. All three values are required; otherwise the
# profit Item sync workspace remains blocked_connector_not_configured.
KJDS_ERPNEXT_BASE_URL=
KJDS_ERPNEXT_API_KEY=
KJDS_ERPNEXT_API_SECRET=

# BAS-160 managed channel credential mode (optional; unbound default).
# Production workers remain fail-closed until an authoritative managed-store
# lease exists with fresh provider readback + external verifier observations.
# KJDS_CHANNEL_LEASE_SIGNING_KEY is the server trust root: never commit it and
# never pass it to AI prompts.
KJDS_CHANNEL_CREDENTIAL_MODE=unbound
KJDS_CHANNEL_LEASE_ISSUER=
KJDS_CHANNEL_LEASE_KEY_ID=
KJDS_CHANNEL_WORKLOAD_IDENTITY_REF=
# KJDS_CHANNEL_LEASE_SIGNING_KEY=
