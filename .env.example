# Copy this file to .env. Never commit the real .env file.
# Supabase: Dashboard -> Connect -> Session pooler (port 5432), then change
# postgres:// to postgresql+psycopg:// and keep sslmode=require.
KJDS_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
KJDS_DATABASE_PROVIDER=supabase
KJDS_REPOSITORY=postgres
KJDS_SHADOW_MODE=true
KJDS_API_KEY=replace-with-a-long-random-development-key
# One-line JSON map of dedicated identities; never print or commit real keys.
# Example: {"pilot-key":{"actor":"ozon-read-worker","roles":["pilot_reader"]},"executor-key":{"actor":"ozon-worker","roles":["executor"]}}
KJDS_API_KEYS_JSON={}
KJDS_API_ACTOR=local-operator
KJDS_API_ROLES=operator
# Dedicated health/integrity identity; map this key to exactly the monitor role.
# Do not reuse the operator, executor, pilot-reader, or Ozon credential.
KJDS_MONITOR_API_KEY=
# Scheduled ControlPlaneOnly health checks must fail closed.
KJDS_HEALTH_REQUIRED=true
KJDS_EVIDENCE_SCAN_PAGE_SIZE=500
KJDS_EVIDENCE_SCAN_MAX_PAGES=20
# Local development may use legacy. Production must use supabase.
KJDS_WEB_AUTH_MODE=legacy
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Non-secret mapping: {"SUPABASE_USER_UUID":"kjds-actor-id"}.
# The actor must have exactly one credential in KJDS_API_KEYS_JSON.
KJDS_WEB_USER_ACTORS_JSON={}
KJDS_PILOT_RUN_LEASE_SECONDS=900
KJDS_EVIDENCE_MAX_BYTES=10485760
KJDS_LIMITED_EXECUTION_ENABLED=false
KJDS_CONTROL_PLANE_URL=http://127.0.0.1:8000
# Dedicated key must appear in KJDS_API_KEYS_JSON with only the executor role.
KJDS_EXECUTOR_API_KEY=
KJDS_EXECUTION_EVIDENCE_ID=
KJDS_PILOT_READER_API_KEY=
KJDS_READ_ONLY_PILOT_ID=
KJDS_READ_ONLY_IDEMPOTENCY_KEY=
KJDS_READ_ONLY_OFFER_ID=
KJDS_READ_ONLY_OFFER_IDS=
KJDS_READ_ONLY_CURSOR=
KJDS_READ_ONLY_PAGE_SIZE=10

# ComfyUI is the controlled media executor. The other providers are optional
# and remain absent unless their URL is explicitly configured.
KJDS_OLLAMA_URL=
KJDS_COMFYUI_URL=http://127.0.0.1:8189
KJDS_N8N_URL=

# 1688 controlled acquisition. Entrypoints are local non-secret Node CLI files.
# Keep the dedicated profile free of personal browsing data and complete login/CAPTCHA manually.
KJDS_OPENCLI_ENTRYPOINT=
KJDS_1688_CLI_ENTRYPOINT=
KJDS_1688_PROFILE=kjds
# One-line JSON, up to 20 candidate keyword searches and 5 results per search.
# Example: [{"candidate_ref":"candidate://compression-main","keyword":"真空压缩收纳袋","max_results":5,"sort":"relevance"}]
KJDS_1688_SEARCHES_JSON=[]
# One-line JSON, at most 20 candidates and 5 suppliers per candidate.
# Example: [{"candidate_ref":"candidate://compression-main","offer_id":"900000000001","seller_id":"public-member-id"}]
KJDS_1688_TARGETS_JSON=[]
# Downloaded media and hashes stay under ignored runtime storage and never imply usage rights.
KJDS_1688_ASSET_DOWNLOAD_ROOT=.runtime/source-assets

# Add only after the corresponding connector is enabled. Do not send these to AI prompts.
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_API_URL=https://api-seller.ozon.ru
OZON_PRODUCT_ATTRIBUTES_PATH=/v4/product/info/attributes
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=
