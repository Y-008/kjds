# Commercial pilot single-customer deployment example.
# Replace every placeholder before use. Do not commit a real tenant, store,
# secret, TLS certificate, or database URL into the repository.

KJDS_DEPLOYMENT_NAME=kjds-commercial-pilot-customer-a
KJDS_DATABASE_NAME=kjds_customer_a
KJDS_POSTGRES_USER=kjds

# Exact one-customer scope. Keep this non-empty and fail closed on blank input.
KJDS_CUSTOMER_SCOPE_JSON={"tenant_ref":"customer-a","entity_ref":"ozon-store-001","store_ref":"store-001","max_sku":500,"max_users":3}

# Browser-facing HTTPS origin for the reverse proxy.
KJDS_WEB_PUBLIC_ORIGIN=https://pilot.example.invalid

# Non-secret production defaults. Override only if the deployment contract changes.
KJDS_API_ACTOR=production-operator
KJDS_API_ROLES=operator
KJDS_API_TENANT=customer-a
KJDS_API_STORES=store-001
KJDS_CHANNEL_LEASE_ISSUER=kjds-managed-store
KJDS_CHANNEL_LEASE_KEY_ID=lease-kid-1
KJDS_PILOT_RUN_LEASE_SECONDS=900
KJDS_LIMITED_EXECUTION_ENABLED=false
KJDS_OZON_EXECUTION_IDENTITY_REF=ozon-worker
KJDS_COMFYUI_URL=http://host.docker.internal:8189

# Durable backup target and schedule. This directory must be outside the
# application/database volume and included in host-level storage monitoring.
KJDS_BACKUP_DIRECTORY=./runtime/backups
KJDS_BACKUP_INTERVAL_SECONDS=86400
KJDS_BACKUP_RETENTION_DAYS=14
KJDS_BACKUP_RUN_ONCE=false

# File-backed secrets. These are references only; the files themselves must be
# injected locally or by the deployment platform.
KJDS_POSTGRES_PASSWORD_FILE=./secrets/postgres-password.txt
KJDS_DATABASE_URL_FILE=./secrets/database-url.txt
KJDS_API_KEY_FILE=./secrets/api-key.txt
KJDS_API_KEYS_JSON_FILE=./secrets/api-keys.json
KJDS_WEB_USER_ACTORS_JSON_FILE=./secrets/web-user-actors.json
KJDS_CHANNEL_LEASE_SIGNING_KEY_FILE=./secrets/channel-lease-signing-key.txt
NEXT_PUBLIC_SUPABASE_URL_FILE=./secrets/next-public-supabase-url.txt
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_FILE=./secrets/next-public-supabase-publishable-key.txt
KJDS_TLS_CERT_FILE=./secrets/tls.crt
KJDS_TLS_KEY_FILE=./secrets/tls.key
